---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign indexable_pages = site.pages | where_exp: "item", "item.canonical" | sort: "canonical" %}
{% for item in indexable_pages %}  <url>
    <loc>{{ item.canonical }}</loc>
{% if item.last_modified %}    <lastmod>{{ item.last_modified | date: "%Y-%m-%d" }}</lastmod>
{% endif %}
  </url>
{% endfor %}</urlset>
